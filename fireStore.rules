rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.super_admin == true;
    }

    function isAdminLike() {
      return isAdmin() || isSuperAdmin();
    }

    // ============================================
    // PUBLIC DATA
    // ============================================

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /operators/{operatorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /globalImpact/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /operator_zones/{zoneId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ============================================
    // USER DATA
    // ============================================

    match /users/{userId} {
  allow read: if isAdminLike() || (isAuthenticated() && request.auth.uid == userId);
  allow create: if isAuthenticated() && request.auth.uid == userId;
  allow update: if isAdminLike() || (isAuthenticated() && request.auth.uid == userId);
  allow delete: if isSuperAdmin();
}


    // ============================================
    // ADMIN DATA
    // ============================================

    match /audits/{auditId} {
      allow read, write: if isAdminLike();
    }

    match /audit_campaigns/{auditId} {
      allow read, write: if isAdminLike();
    }

    // ============================================
    // OPERATIONAL DATA
    // ============================================

    match /pickups/{pickupId} {
      allow read, write: if isAuthenticated();
    }

    match /pickup_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // DEFAULT DENY
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
