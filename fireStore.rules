rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOperator() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'OPERATOR';
    }

    function belongsToOperator(operatorId) {
      return isOperator() && request.auth.token.get('operatorId', '') == operatorId;
    }

    function isAuthority() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'AUTHORITY';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'ADMIN' || request.auth.token.get('admin', false) == true
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.get('super_admin', false) == true;
    }

    function isAdminLike() {
      return isAdmin() || isSuperAdmin();
    }

    // ============================================
    // PUBLIC DATA
    // ============================================

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdminLike();
    }

    match /operators/{operatorId} {
      allow read: if true;
      allow write: if isAdminLike();
    }

    match /globalImpact/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /operator_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdminLike();
    }

    // ============================================
    // USER DATA
    // ============================================

    match /users/{userId} {
  allow read: if isAdminLike() || (isAuthenticated() && request.auth.uid == userId);
  allow create: if isAuthenticated() && request.auth.uid == userId;
  allow update: if isAdminLike() || (isAuthenticated() && request.auth.uid == userId);
  allow delete: if isSuperAdmin();
}


    // ============================================
    // ADMIN DATA
    // ============================================

    match /audits/{auditId} {
      allow read, write: if isAdminLike();
    }

    match /audit_campaigns/{auditId} {
      allow read, write: if isAdminLike();
    }

    // ============================================
    // OPERATIONAL DATA
    // ============================================

    match /pickups/{pickupId} {
      allow read: if isAdminLike();
      allow write: if false;
    }

    match /pickup_requests/{requestId} {
      allow read: if isAdminLike();
      allow write: if false;
    }


    // ============================================
    // PHASE 1 — CONFIG VERSIONING (server-write-only)
    // ============================================
    match /campaignConfigVersions/{versionId} {
      allow read: if isAdminLike() || isOperator() || isAuthority();
      allow write: if false;
    }
    match /campaignConfigApprovals/{approvalId} {
      allow read: if isAdminLike();
      allow write: if false;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /tveRuns/{runId} {
  allow read: if isAdminLike()
    || (isOperator() && resource.data.computedBy != null);
  allow write: if false;
}

match /recalibrations/{recalibrationId} {
  allow read: if isAdminLike()
    || (isOperator() && belongsToOperator(resource.data.operatorId))
    || (isAuthority());
  allow write: if false;
}

match /hazardCache/{communeCode} {
  allow read: if isAuthenticated();
  allow write: if false;
}

match /stakes/{stakeId} {
  allow read: if isAdminLike()
    || (isOperator() && belongsToOperator(resource.data.operatorId));
  allow create, update, delete: if false;

  match /drafts/{type} {
    allow read: if isAdminLike()
      || (isOperator() && belongsToOperator(
        get(/databases/$(database)/documents/stakes/$(stakeId)).data.operatorId
      ));
    allow write: if false;
  }
}

match /businessModelScenarios/{scenarioId} {
  allow read: if isAdminLike() || isAuthority() || isOperator();
  allow write: if false;
}

match /oveValidations/{validationId} {
  allow read: if isAdminLike() || isAuthority() || isOperator();
  allow write: if false;
}

match /stakeIns/{stakeInId} {
  allow read: if isAdminLike()
    || (isOperator() && belongsToOperator(resource.data.operatorId));
  allow write: if false;
}

  }
}
